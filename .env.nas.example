# ============================================================
# CASAMABLE™ — configuración de PRODUCCIÓN en el NAS (UGREEN DXP2800)
#
#   cp .env.nas.example .env     y rellena los huecos marcados con ⬅
#
# Este fichero se llama .env (no .env.local) porque es el que lee
# docker compose. NUNCA se sube a Git.
# ============================================================

# ------------------------------------------------------------
# DOCKER / NAS
# ------------------------------------------------------------

# ⬅ RUTA PERSISTENTE DEL NAS: carpeta REAL donde viven auth/, data/ y
# backups/. Si no existe, Docker crearía carpetas vacías y perderías la
# sesión de WhatsApp al recrear el contenedor.
# Averigua la ruta real en UGOS Pro (ver docs/UGREEN-DXP2800-DEPLOY.md).
# Ejemplo típico: /volume1/docker/CasamableAgent
PERSIST_DIR=

# Puerto del NAS por el que se abre el panel (cámbialo si el 3000 está usado)
HOST_PORT=3000

NODE_ENV=production
TZ=Europe/Madrid

# ------------------------------------------------------------
# SEGURIDAD — el sistema arranca así de restringido a propósito
# ------------------------------------------------------------

APP_MODE=production

# 1 = solo actúa sobre TEST_PHONE_ALLOWLIST + pedidos autorizados a mano.
# MANTENER EN 1 durante toda la instalación y el piloto.
TEST_MODE=1

# ⬅ Teléfonos de prueba (con prefijo país, separados por comas)
TEST_PHONE_ALLOWLIST=

WHATSAPP_SEND_ENABLED=1
SHOPIFY_WRITE_ENABLED=1

# Kill switch: 1 = bloquea TODA acción externa al instante.
EMERGENCY_STOP=0

# Anti-replay: un pedido más antiguo que esto no dispara nada.
MAX_ORDER_AGE_MINUTES=30
OUTBOX_MAX_AGE_MINUTES=60

# Ventana horaria de envío (hora España). Fuera de ella los pedidos esperan
# a la apertura sin perderse ni caducar.
WHATSAPP_WINDOW_START=09:00
WHATSAPP_WINDOW_END=21:00
WHATSAPP_TIMEZONE=Europe/Madrid
WHATSAPP_WINDOW_ENABLED=1

# ⬅ OBLIGATORIA en producción: el panel muestra datos de clientes reales.
# Si está vacía, el contenedor se niega a arrancar (a propósito).
DASHBOARD_PASSWORD=

# ------------------------------------------------------------
# WHATSAPP
# ------------------------------------------------------------

# Número dedicado de WhatsApp Business de Casamable (el único emisor).
BUSINESS_WHATSAPP_NUMBER=34641308254

# Móvil que RECIBE avisos técnicos del sistema (no es el emisor).
ALERT_WHATSAPP=

# ------------------------------------------------------------
# SHOPIFY
# ------------------------------------------------------------

SHOPIFY_STORE_DOMAIN=qmbr1z-vf.myshopify.com
SHOPIFY_API_VERSION=2026-07

# ⬅ Clave de firma de los webhooks (Configuración → Notificaciones → Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# ⬅ Credenciales del Dev Dashboard (el token se pide y renueva solo).
# La app debe estar INSTALADA en la tienda con read_orders + write_orders.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Alternativa: token estático shpat_… (si lo pones, tiene prioridad)
# SHOPIFY_ADMIN_ACCESS_TOKEN=

# ------------------------------------------------------------
# CONFIRMACIÓN COD
# ------------------------------------------------------------

FIRST_REMINDER_MINUTES=30
NEEDS_CALL_MINUTES=120
ORDER_POLL_SECONDS=20
SHOP_NAME=Casamable™

COD_GATEWAY_KEYWORDS=cod,cash on delivery,contra reembolso,contrareembolso,releasit
TREAT_ALL_ORDERS_AS_COD=0
COD_PENDING_IS_COD=0
DEFAULT_COUNTRY_CODE=34

# ------------------------------------------------------------
# BACKUPS
# ------------------------------------------------------------

BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=7

# ------------------------------------------------------------
# ACCESO EXTERNO (opcional, solo si usas el túnel de Cloudflare)
# ------------------------------------------------------------

# ⬅ Token del túnel nombrado (Cloudflare Zero Trust → Tunnels).
# Se activa con: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------
# SISTEMA
# ------------------------------------------------------------

LOG_LEVEL=info
STORE_RAW_PAYLOAD=1

# IA desactivada (el flujo COD no la usa: coste 0 €)
OPENROUTER_API_KEY=
AI_AGENT_ENABLED=0
