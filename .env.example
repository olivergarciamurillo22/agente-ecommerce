# ============================================================
# CASAMABLE™ — MVP CONFIRMACIÓN PEDIDOS COD
# Copia este archivo a .env.local y pega tus credenciales.
# Nunca subas .env.local a Git ni pegues secretos en un chat.
# ============================================================

# ------------------------------------------------------------
# SEGURIDAD (leer PEDRO-MVP.md § Rollout antes de tocar nada)
#
# Con esta configuración por defecto NO PUEDE ocurrir ninguna acción real:
# ni WhatsApps, ni escrituras en Shopify, aunque haya credenciales puestas.
# Producción exige VARIAS decisiones explícitas simultáneas.
# ------------------------------------------------------------

# safe | production. Cualquier otro valor (o vacío) = safe.
APP_MODE=safe

# 1 = solo se actúa sobre teléfonos de TEST_PHONE_ALLOWLIST. 0 = todos.
TEST_MODE=1

# Teléfonos de prueba autorizados (dígitos con prefijo país, separados por comas)
# Ej: TEST_PHONE_ALLOWLIST=34600111222,34600333444
TEST_PHONE_ALLOWLIST=

# Doble llave de WhatsApp: solo envía con APP_MODE=production Y esto en 1.
WHATSAPP_SEND_ENABLED=0

# Doble llave de Shopify: solo escribe (tag WA_CONFIRMED) con production Y 1.
SHOPIFY_WRITE_ENABLED=0

# KILL SWITCH global: 1 = bloquea TODA acción externa al instante.
# (Por defecto activado; en producción real se pone conscientemente a 0.)
EMERGENCY_STOP=1

# Un pedido con más de X minutos jamás dispara acciones (anti-replay/backfill).
# OJO: esperar a la ventana horaria NO cuenta para esta antigüedad.
MAX_ORDER_AGE_MINUTES=30

# ── VENTANA HORARIA DE ENVÍO ──
# Nadie recibe un WhatsApp de madrugada: fuera de esta franja los pedidos se
# guardan igual y el mensaje inicial (y los recordatorios) esperan a la
# siguiente apertura. Las respuestas a quien escribe NO se retienen.
WHATSAPP_WINDOW_START=09:00
WHATSAPP_WINDOW_END=21:00
WHATSAPP_TIMEZONE=Europe/Madrid
# 0 = desactivar la ventana (enviar a cualquier hora)
WHATSAPP_WINDOW_ENABLED=1

# Mensajes en outbox con más de X minutos quedan retenidos (revisar con
# npm run outbox:inspect y limpiar con npm run outbox:clear-safe).
OUTBOX_MAX_AGE_MINUTES=60

# ------------------------------------------------------------
# SHOPIFY
# ------------------------------------------------------------

# Dominio interno de Shopify, sin https://
SHOPIFY_STORE_DOMAIN=qmbr1z-vf.myshopify.com

# Secret usado para validar la firma HMAC de los webhooks Shopify.
# ¿Cuál pegar? Depende de CÓMO se creó el webhook:
#  - Creado a mano en Configuración → Notificaciones → Webhooks:
#    la clave que aparece en esa misma página ("Tus webhooks se firmarán con...").
#  - Creado por una app / API: el "client secret" de la app (shpss_...).
SHOPIFY_WEBHOOK_SECRET=

# ── ACCESO A LA ADMIN API (solo para el tag WA_CONFIRMED) ──
# Dos vías posibles; basta con UNA. Si están las dos, manda el token estático.
# Sin ninguna, todo funciona igual pero sin tag (se aplica retroactivamente
# a los confirmados de los últimos 7 días en cuanto haya credencial válida).
#
# VÍA A · Token estático de app clásica (empieza por shpat_).
# Scopes mínimos: read_orders + write_orders.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# VÍA B · Shopify Dev Dashboard (client credentials). El sistema pide el
# token de acceso solo y lo renueva cuando caduca (~24h). La app debe estar
# instalada en la tienda con read_orders + write_orders.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Versión API Shopify
SHOPIFY_API_VERSION=2026-07

# ------------------------------------------------------------
# CONFIRMACIÓN COD
# ------------------------------------------------------------

# Minutos hasta enviar recordatorio (admite decimales; en pruebas usa 1)
FIRST_REMINDER_MINUTES=30

# Minutos desde el primer mensaje hasta marcar NEEDS_CALL (en pruebas usa 2)
NEEDS_CALL_MINUTES=120

# Frecuencia del scheduler (segundos)
ORDER_POLL_SECONDS=20

# Nombre comercial que aparece en los mensajes de WhatsApp
SHOP_NAME=Casamable™

# Número DEDICADO de WhatsApp Business de Casamable (dígitos con prefijo país,
# ej. 34XXXXXXXXX). Es el ÚNICO número emisor del sistema: se vincula por QR.
# Nunca el número personal de Pedro. Si el WhatsApp que se conecta no coincide
# con este valor, el bot lo avisa en el log. Vacío hasta tener la línea nueva.
BUSINESS_WHATSAPP_NUMBER=

# ------------------------------------------------------------
# DETECCIÓN COD
# ------------------------------------------------------------

# Señal PRIMARIA (automática, no configurable): el tag releasit_cod_form que
# Releasit COD Form pone en cada pedido del formulario (49/49 comprobados).
# Estas keywords son el FALLBACK sobre payment_gateway_names / gateway / tags:
COD_GATEWAY_KEYWORDS=cod,cash on delivery,contra reembolso,contrareembolso,releasit

# 1 = tratar TODOS los pedidos como COD (SOLO desarrollo/pruebas)
TREAT_ALL_ORDERS_AS_COD=0

# 1 = aceptar cualquier pedido con pago pendiente como COD (red amplia:
# atraparía también transferencias). pending por sí solo NO basta con 0.
COD_PENDING_IS_COD=0

# ------------------------------------------------------------
# TELÉFONOS
# ------------------------------------------------------------

# Prefijo de país que se añade a teléfonos nacionales (34 = España)
DEFAULT_COUNTRY_CODE=34

# ------------------------------------------------------------
# DASHBOARD
# ------------------------------------------------------------

# Vacío en local. Añadir contraseña si exponemos el dashboard públicamente
# (el navegador la pedirá; los webhooks y /api/health siguen abiertos).
DASHBOARD_PASSWORD=

# ------------------------------------------------------------
# SISTEMA
# ------------------------------------------------------------

PORT=3000
LOG_LEVEL=info

# Guardar el payload completo del pedido en SQLite para depurar (1 sí / 0 no)
STORE_RAW_PAYLOAD=1

# Móvil (prefijo país + número, solo dígitos, ej. 34600111222) al que el
# sistema avisa por WhatsApp si algo va mal. Vacío = solo logs.
# OJO: es quien RECIBE avisos técnicos; los mensajes a clientes salen del
# WhatsApp que se vincula con el QR.
ALERT_WHATSAPP=

# ------------------------------------------------------------
# PROVEEDORES · Dropi PRO / Dropea (fase 2 — SOLO SIMULACIÓN)
#
# La integración está preparada pero NO conectada: faltan las APIs reales.
# Con estos valores no se hace ninguna llamada externa, solo se evalúa qué
# proveedor tocaría y qué bloquearía el envío (se ve en el panel y con
# `npm run supplier:simulate`).
# ------------------------------------------------------------

# Interruptor maestro. 0 = ningún envío a proveedores (por defecto).
# ⚠️ CANDADO CONTRA LA DOBLE INTEGRACIÓN.
# Los pedidos de Shopify llegan con tags `dropea_error` y "Sync ERROR - Dropi
# PRO": YA hay otra integración creando pedidos en los proveedores. Si la
# nuestra también los crea, cada compra se enviaría DOS VECES al cliente.
# Mientras esto sea 0, la creación de pedidos está BLOQUEADA aunque el resto
# de llaves estén abiertas. Ponlo a 1 solo cuando se confirme que la
# integración antigua está desactivada.
LEGACY_SUPPLIER_INTEGRATIONS_DISABLED=0

SUPPLIER_SYNC_ENABLED=0
# 1 = solo simulación, jamás llamadas reales (por defecto).
SUPPLIER_TEST_MODE=1

# Segunda llave por plataforma (como con Shopify).
DROPIPRO_WRITE_ENABLED=0
DROPEA_WRITE_ENABLED=0

# Reglas de enrutado por producto. Formato: plataforma:palabra|palabra,...
# VACÍO = ningún pedido se enruta solo (todos van a revisión manual), que es
# lo correcto hasta tener el handoff. Ejemplo de uso futuro:
#   SUPPLIER_ROUTING_RULES=dropi:limpiador,dropea:cortauñas|pulidor
SUPPLIER_ROUTING_RULES=

# Credenciales (se rellenarán cuando llegue la documentación de cada API).
# No se validan al arrancar mientras SUPPLIER_SYNC_ENABLED=0.
DROPIPRO_API_BASE_URL=
DROPIPRO_API_KEY=

# ── DROPEA · API (contrato oficial verificado, ver docs/DROPEA-API-CONTRACT.md) ──
# Mercado: el host cambia por país (es | pt | it). España por defecto.
# ── DROPEA · MODO DE CREACIÓN (lo más importante) ──
# external_app = los pedidos los crea la APP OFICIAL de Dropea en Shopify.
#                Nosotros solo leemos, seguimos el envío y avisamos al
#                cliente. NUNCA creamos. ← modo por defecto y actual.
# our_api      = los crearíamos nosotros (aún no).
DROPEA_CREATE_MODE=external_app

# ¿Sigue activa la app oficial creando pedidos? 1 = sí (se asume lo peor).
# Mientras sea 1, nuestra creación está bloqueada aunque el modo sea our_api.
DROPEA_LEGACY_CREATE_ACTIVE=1

# 1 = bloquear el pedido si trae nota para el repartidor (Dropea no admite
# ese campo). Por defecto 0: se registra como "unsupported" y se avisa.
DROPEA_BLOCK_ON_DELIVERY_NOTE=0

DROPEA_MARKET=es
# Se deriva del mercado si se deja vacío: https://es.public-api.dropea.com
DROPEA_API_BASE_URL=
# API key (JWT) del panel: Settings → API Keys. Se muestra UNA sola vez.
DROPEA_API_KEY=
# 1 = permitir LEER de la API (consultar pedidos, catálogo, estados).
# Es seguro: no modifica nada.
DROPEA_API_ENABLED=0
# 1 = permitir ESCRIBIR (crear/cancelar). Exige además los safety gates
# generales y el candado LEGACY_SUPPLIER_INTEGRATIONS_DISABLED.
# Secretos para VERIFICAR los webhooks que ellos nos envíen (estados/tracking).
# El endpoint receptor todavía NO existe: se implementará con el handoff.
# Déjalos vacíos hasta entonces.
DROPEA_WEBHOOK_SECRET=
DROPIPRO_WEBHOOK_SECRET=
# ── TRACKING Y AVISOS DE POSTVENTA ──
# Estado del envío: se consulta a los proveedores (webhook + polling) y se
# avisa al cliente por WhatsApp. Cada aviso se manda UNA sola vez.

# Aviso al aparecer el número de seguimiento y al entrar en reparto: se
# disparan solos con el flujo. El de ENTREGA está apagado hasta revisar copy.
DELIVERED_WHATSAPP_ENABLED=0

# Cadencia del polling de estado (minutos por situación del envío)
TRACKING_POLL_SECONDS=300
TRACKING_POLL_DEFAULT_MIN=10
TRACKING_POLL_IN_TRANSIT_MIN=15
TRACKING_POLL_OUT_FOR_DELIVERY_MIN=5
TRACKING_POLL_INCIDENT_MIN=30

# Traducción de estados del proveedor a los nuestros, sin tocar código:
#   SUPPLIER_STATUS_MAP=GUIA_GENERADA:shipped,EN_BODEGA:processing
# Lo que no esté aquí ni en el mapa por defecto se queda en "unknown".
SUPPLIER_STATUS_MAP=

# Piloto de proveedores: con 1 (por defecto) un pedido solo sale a proveedor
# si se aprueba UNO A UNO desde el panel (supplier_pilot_approved).
SUPPLIER_PILOT_MODE=1

# Webhooks de proveedor: cabecera y codificación de la firma (se ajustarán
# con su documentación). Sin secreto configurado, los webhooks se RECHAZAN.
# ── DROPI: webhook de actualizaciones de pedido ──
# Dropi manda POSTs a nuestra URL con el estado del envío (estructura
# confirmada en docs/DROPI-API-CONTRACT.md). NO sabemos todavía si firma esas
# notificaciones, así que el receptor está DESHABILITADO: responde 503.
# Ponlo a 1 SOLO cuando exista un mecanismo de autenticación confirmado.
DROPIPRO_WEBHOOK_ENABLED=0

# Traducción de estados de Dropi a los nuestros, por id o por nombre:
#   DROPI_STATUS_MAP=4:out_for_delivery,7:delivered
# VACÍO = todos los estados quedan en "unknown" y NO se avisa al cliente,
# que es lo correcto hasta que Pedro confirme el catálogo de estados.
DROPI_STATUS_MAP=

# ------------------------------------------------------------
# OPCIONAL / NO USADO EN ESTE MVP
# ------------------------------------------------------------

# El flujo de confirmación es determinista y funciona con esto VACÍO (coste
# IA = 0 €). El agente conversacional del kit exige DOBLE opt-in: además de la
# key hay que poner AI_AGENT_ENABLED=1 (así una key suelta jamás activa un bot
# comercial hablando con clientes COD por accidente).
OPENROUTER_API_KEY=
AI_AGENT_ENABLED=0

# ------------------------------------------------------------
# LEGACY / OPTIONAL (herencia del kit de agente IA; ignorar para el MVP)
# ------------------------------------------------------------

OPENROUTER_MODEL=anthropic/claude-haiku-4.5
BUFFER_SECONDS=10
TRANSCRIPTION_MODEL=google/gemini-2.5-flash
VISION_MODEL=google/gemini-2.5-flash
ALLOWED_PRICES=
ALLOWED_HOSTS=
CHECKOUT_URL=
SECURITY_CANARY=
GUARD_FALLBACK_MSG=
CAL_BOOKING_URL=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE=
AIRTABLE_AGENT_UTM=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ============================================================
# CONTROL CENTER (pestaña "Sistema" del panel) — todo opcional
# ============================================================

# 0 apaga la instrumentación (latidos, eventos). Encendida por defecto.
SYSTEM_HEALTH_ENABLED=1
# Un envío activo sin noticias en más de estas horas sale como "sin noticias".
TRACKING_STALE_HOURS=12
# Antigüedad de la última copia de seguridad que dispara aviso / crítico.
BACKUP_WARNING_HOURS=24
BACKUP_CRITICAL_HOURS=48
# Un mensaje pendiente en la cola más de estos minutos dispara aviso.
OUTBOX_STALE_MINUTES=15
